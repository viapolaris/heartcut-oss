# Copy to .env (gitignored) and fill in only what you use. Heartcut reads it again on every check, so a new key
# or provider choice needs no restart: reload the page. Only PORT, HEARTCUT_PORT, HEARTCUT_HOST, HEARTCUT_ROOT and
# HEARTCUT_MEDIA_ROOT are read once at start; restart Heartcut after changing those.
# Keys live here or in your shell environment. They are never saved in settings or shown in the dashboard.
# With nothing set, Heartcut picks a language model by itself: the `claude` CLI if it is installed, else the first
# key below that is set, else a local Ollama or LM Studio server.

# Pick a provider here, or in the dashboard (Brief step, Language model). A saved dashboard choice wins.
# auto | claude-cli | anthropic | openai | xai | gemini | openrouter | ollama | lmstudio | custom
HEARTCUT_LLM_PROVIDER=
# custom only: any OpenAI-compatible base URL, e.g. http://127.0.0.1:8080/v1
HEARTCUT_LLM_BASE_URL=
# One model for every step, or one per tier (opus = careful, sonnet = default, haiku = quick)
HEARTCUT_LLM_MODEL=
HEARTCUT_LLM_MODEL_OPUS=
HEARTCUT_LLM_MODEL_SONNET=
HEARTCUT_LLM_MODEL_HAIKU=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# custom servers that need a key
HEARTCUT_LLM_API_KEY=

# ---------- Pictures and video ----------
# One key is enough. With several, the dashboard (Brief step, Pictures and video) or HEARTCUT_GEN_PROVIDER picks.
# auto | higgsfield | fal | replicate | higgsfield-tool
HEARTCUT_GEN_PROVIDER=
# fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=
# Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Higgsfield: the key id and its secret (console.higgsfield.ai). Or HIGGSFIELD_API_KEY=id:secret on its own.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional: an external Higgsfield CLI tool that keeps its own key and cap (used automatically when set)
HEARTCUT_HIGGSFIELD_TOOL=
# Spending cap per sitting (the last 6 hours), in dollars. Default 5. A clip whose price is not known before it is
# sent reserves HEARTCUT_VIDEO_RESERVE (default 2.50) against the cap until it finishes.
HEARTCUT_SPEND_CAP=
HEARTCUT_VIDEO_RESERVE=

# ---------- Free local pictures (Apple Silicon Mac) ----------
# Setup is in tools/local-image.py. Point at another worker copy, or use a plain Python instead of uv:
HEARTCUT_LOCAL_WORKER=
HEARTCUT_LOCAL_PYTHON=

# ---------- Server and folders ----------
# Where pictures and clips are saved. Default: media/ in the Heartcut folder.
# HEARTCUT_MEDIA_ROOT=
# Dashboard port. Default 5088. HEARTCUT_PORT wins over PORT when both are set.
# PORT=
# HEARTCUT_PORT=
# Address the dashboard listens on. Default 127.0.0.1 (this machine only).
# HEARTCUT_HOST=
# Set to 1 for fake mode: no network, no keys, no spend, placeholder pictures and clips.
# HEARTCUT_FAKE=
# Where projects/ lives. Default: the Heartcut folder.
# HEARTCUT_ROOT=
# Full paths to ffmpeg and ffprobe, when they are not on your PATH.
# HEARTCUT_FFMPEG=
# HEARTCUT_FFPROBE=
# Render drawn looks on this Mac: 1 for on, 0 for off. Default: on when the Mac can. The dashboard switch wins.
# HEARTCUT_PREFER_LOCAL=
